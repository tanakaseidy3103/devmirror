# DevMirror — バックエンド環境変数サンプル

# アプリケーション
APP_NAME=DevMirror
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# データベース
DATABASE_URL=sqlite+aiosqlite:///./devmirror.db

# AI (オプション - 未設定の場合はMockAnalyzerを使用)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# セキュリティ
ALLOWED_COMMAND_TIMEOUT=30
MAX_LOG_SIZE_BYTES=1048576

# CORS（リストは JSON 形式）
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------- VM Provider
# "mock"       = シミュレーションのみ
# "qemu"       = QEMU + KVM（ブラウザから VM に入れる）
# "virtualbox" = VirtualBox
VM_PROVIDER=mock

# ---------------------------------------------------------------- QEMU（推奨）
# WSL2 + KVM で動かす。VirtualBox と違い、ブラウザから VM に入れる。
# 準備:
#   sudo usermod -aG kvm $USER      # 権限（ターミナルを開き直す）
#   sudo apt install -y qemu-system-x86 qemu-utils
#   python -m scripts.prepare_qemu --build
#
# 空なら PATH から自動検出する
QEMU_BINARY=
QEMU_IMG_BINARY=

# 3 環境の親となる基準ディスクと、起動時に挿す ISO
# scripts/prepare_qemu が設定すべき値を表示する
QEMU_BASE_IMAGE=
QEMU_BOOT_ISO=

# overlay（差分ディスク）を置くディレクトリ
QEMU_VM_DIR=

# 環境名（リストは JSON 形式）
QEMU_VM_NAMES=["envA","envB","envC"]

# VNC ポート。envA=5901 / envB=5902 / envC=5903
QEMU_VNC_BASE_PORT=5901

# 1 台あたりの割り当て。3 台同時に動かすため合計が物理メモリを超えないこと
QEMU_MEMORY_MB=2048
QEMU_CPUS=2

# kvm = ハードウェア加速 / tcg = ソフトウェアエミュレーション（非常に遅い）
QEMU_ACCEL=kvm

QEMU_BOOT_TIMEOUT=180
QEMU_STOP_TIMEOUT=30

# ---------------------------------------------------------------- VirtualBox
# 空なら OS の標準パスから自動検出する
# 例: C:\Program Files\Oracle\VirtualBox\VBoxManage.exe
VBOXMANAGE_PATH=

# Guest Additions を入れた基準 VM の名前（クローン元）
VBOX_BASE_VM=DevMirror-Base
# linked = 高速・ディスク共有 / all = 完全複製
VBOX_CLONE_MODE=linked
VBOX_CLONE_PREFIX=DevMirror

# 3 台同時に動かすため 1 台あたりの割り当て。合計が物理メモリを超えないこと
VBOX_MEMORY_MB=2048
VBOX_CPUS=2

# 起動待ち（秒）
VBOX_BOOT_TIMEOUT=180
VBOX_GUEST_READY_TIMEOUT=120

# guestcontrol の認証情報（VM 内に作るユーザー）
VBOX_GUEST_USERNAME=
VBOX_GUEST_PASSWORD=

# ホスト側 DX プロジェクトの場所（VM へコピーする元）
# 例: C:\dev\DXGame
VBOX_PROJECT_PATH=
# ゲスト側の配置先
VBOX_GUEST_PATH=C:\DevMirror\app

# 再実行のたびに VM を破棄しない
VBOX_KEEP_VM=false
